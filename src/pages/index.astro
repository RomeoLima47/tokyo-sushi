---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import OrderButtons from "../components/OrderButtons.astro";

import { restaurant } from "../data/restaurant";

const title =
  "Tokyo Sushi & Korean Bistro | Japanese & Korean Food in Fort Lauderdale";

const description =
  "Tokyo Sushi & Korean Bistro serves sushi, sashimi, Korean BBQ, ramen, noodles and Japanese and Korean favorites in Fort Lauderdale, Florida.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",

  name: restaurant.name,

  url: restaurant.website,

  description: restaurant.description,

  telephone: restaurant.phoneDisplay,

  email: restaurant.email,

  servesCuisine: [
    "Japanese",
    "Sushi",
    "Sashimi",
    "Korean",
    "Korean BBQ",
    "Ramen"
  ],

  hasMenu: `${restaurant.website}/menu`,

  acceptsReservations: restaurant.acceptsReservations,

  address: {
    "@type": "PostalAddress",

    streetAddress:
      restaurant.address.street,

    addressLocality:
      restaurant.address.city,

    addressRegion:
      restaurant.address.state,

    postalCode:
      restaurant.address.postalCode,

    addressCountry:
      restaurant.address.country
  },

  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",

      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ],

      opens: "11:45",

      closes: "23:00"
    },

    {
      "@type": "OpeningHoursSpecification",

      dayOfWeek: "Sunday",

      opens: "17:00",

      closes: "23:00"
    }
  ],

  potentialAction: {
    "@type": "OrderAction",

    target:
      restaurant.links.order
  }
};
---

<Layout
  title={title}
  description={description}
>

  <!-- RESTAURANT STRUCTURED DATA -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />


  <!-- HEADER -->

  <Header />


  <main>

    <!-- HERO -->

    <Hero />


    <!-- ORDER ONLINE -->

    <section class="py-20">

      <div
        class="mx-auto max-w-6xl px-5 text-center lg:px-8"
      >

        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-red-800"
        >
          Hungry?
        </p>


        <h2
          class="mt-3 text-4xl font-bold tracking-tight"
        >
          Order your way.
        </h2>


        <p
          class="mx-auto mt-4 max-w-xl leading-7 text-black/60"
        >
          Order directly for pickup or choose your preferred
          delivery service.
        </p>


        <div
          class="mx-auto mt-10 max-w-3xl"
        >

          <OrderButtons />

        </div>

      </div>

    </section>


    <!-- MENU PREVIEW -->

    <section
      class="bg-white py-20"
    >

      <div
        class="mx-auto max-w-7xl px-5 lg:px-8"
      >

        <!-- SECTION HEADING -->

        <div class="text-center">

          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-red-800"
          >
            Our Food
          </p>


          <h2
            class="mt-3 text-4xl font-bold tracking-tight"
          >
            Japanese & Korean favorites
          </h2>


          <p
            class="mx-auto mt-4 max-w-2xl leading-7 text-black/60"
          >
            Explore sushi, sashimi, Korean BBQ, ramen,
            noodles, specialty rolls and weekday lunch favorites.
          </p>

        </div>


        <!-- MENU CATEGORY CARDS -->

        <div
          class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4"
        >

          <!-- SUSHI & SASHIMI -->

          <article
            class="rounded-xl border border-black/10 p-7 transition hover:border-black/25 hover:shadow-sm"
          >

            <h3
              class="text-xl font-semibold"
            >
              Sushi & Sashimi
            </h3>


            <p
              class="mt-3 leading-7 text-black/60"
            >
              Sushi, sashimi, maki and house specialty rolls.
            </p>

          </article>


          <!-- KOREAN BBQ -->

          <article
            class="rounded-xl border border-black/10 p-7 transition hover:border-black/25 hover:shadow-sm"
          >

            <h3
              class="text-xl font-semibold"
            >
              Korean BBQ
            </h3>


            <p
              class="mt-3 leading-7 text-black/60"
            >
              Bulgogi, Korean short ribs, pork belly
              and other Korean favorites.
            </p>

          </article>


          <!-- RAMEN & NOODLES -->

          <article
            class="rounded-xl border border-black/10 p-7 transition hover:border-black/25 hover:shadow-sm"
          >

            <h3
              class="text-xl font-semibold"
            >
              Ramen & Noodles
            </h3>


            <p
              class="mt-3 leading-7 text-black/60"
            >
              Ramen, Korean noodle dishes and comforting
              house specialties.
            </p>

          </article>


          <!-- LUNCH -->

          <article
            class="rounded-xl border border-black/10 p-7 transition hover:border-black/25 hover:shadow-sm"
          >

            <h3
              class="text-xl font-semibold"
            >
              Lunch
            </h3>


            <p
              class="mt-3 leading-7 text-black/60"
            >
              Weekday lunch selections including sushi,
              Korean plates, noodles and more.
            </p>

          </article>

        </div>


        <!-- MENU BUTTONS -->

        <div
          class="mt-10 flex flex-wrap justify-center gap-3"
        >

          <a
            href="/menu"
            class="rounded-md bg-black px-6 py-3 font-semibold text-white transition hover:bg-black/80"
          >
            Dinner Menu
          </a>


          <a
            href="/lunch"
            class="rounded-md border border-black/20 px-6 py-3 font-semibold transition hover:bg-black hover:text-white"
          >
            Lunch Menu
          </a>

        </div>

      </div>

    </section>


    <!-- LOCATION -->

    <section
      id="location"
      class="py-20"
    >

      <div
        class="mx-auto grid max-w-7xl gap-12 px-5 md:grid-cols-2 lg:px-8"
      >

        <!-- LOCATION INFORMATION -->

        <div>

          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-red-800"
          >
            Visit Us
          </p>


          <h2
            class="mt-3 text-4xl font-bold tracking-tight"
          >
            Tokyo Sushi & Korean Bistro
          </h2>


          {
            restaurant.address.street ? (

              <address
                class="mt-5 not-italic leading-7 text-black/60"
              >

                {restaurant.address.street}

                <br />

                {restaurant.address.city},{" "}
                {restaurant.address.state}{" "}
                {restaurant.address.postalCode}

              </address>

            ) : (

              <p
                class="mt-5 leading-7 text-black/60"
              >
                Fort Lauderdale, Florida
              </p>

            )
          }


          <div
            class="mt-8 flex flex-wrap gap-3"
          >

            {
              restaurant.links.googleMaps && (

                <a
                  href={restaurant.links.googleMaps}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-md bg-black px-5 py-3 font-semibold text-white transition hover:bg-black/80"
                >
                  Get Directions
                </a>

              )
            }


            <a
              href="/contact"
              class="rounded-md border border-black/20 px-5 py-3 font-semibold transition hover:bg-black hover:text-white"
            >
              Contact & Hours
            </a>

          </div>

        </div>


        <!-- LOCATION CARD -->

        <div
          class="rounded-xl bg-[#ebe4d7] p-8 sm:p-10"
        >

          <p
            class="text-sm uppercase tracking-widest text-black/50"
          >
            Location
          </p>


          <p
            class="mt-3 text-xl font-semibold"
          >
            {restaurant.address.city}, {restaurant.address.state}
          </p>


          {
            restaurant.address.street && (

              <p
                class="mt-2 leading-6 text-black/60"
              >
                {restaurant.address.street}

                <br />

                {restaurant.address.city},{" "}
                {restaurant.address.state}{" "}
                {restaurant.address.postalCode}
              </p>

            )
          }


          {
            restaurant.phoneDisplay && (

              <div
                class="mt-7"
              >

                <p
                  class="text-xs font-semibold uppercase tracking-wider text-black/40"
                >
                  Phone
                </p>


                <a
                  href={`tel:${restaurant.phone}`}
                  class="mt-1 inline-block text-lg font-semibold hover:text-red-800"
                >
                  {restaurant.phoneDisplay}
                </a>

              </div>

            )
          }


          {
            restaurant.lunchHours && (

              <div
                class="mt-7"
              >

                <p
                  class="text-xs font-semibold uppercase tracking-wider text-black/40"
                >
                  Lunch
                </p>


                <p
                  class="mt-1 leading-6 text-black/70"
                >
                  {restaurant.lunchHours.days}

                  <br />

                  {restaurant.lunchHours.hours}
                </p>

              </div>

            )
          }


          {
            restaurant.links.googleMaps && (

              <a
                href={restaurant.links.googleMaps}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-8 inline-flex rounded-md bg-black px-5 py-3 font-semibold text-white transition hover:bg-black/80"
              >
                Get Directions
              </a>

            )
          }

        </div>

      </div>

    </section>


    <!-- FINAL ORDER CTA -->

    <section
      class="bg-red-900 text-white"
    >

      <div
        class="mx-auto max-w-5xl px-5 py-16 text-center lg:px-8"
      >

        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-red-200"
        >
          Tokyo Sushi & Korean Bistro
        </p>


        <h2
          class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
        >
          Ready to order?
        </h2>


        <p
          class="mx-auto mt-4 max-w-xl leading-7 text-white/70"
        >
          Order directly online for convenient pickup or delivery.
        </p>


        <a
          href={restaurant.links.order}
          class="mt-7 inline-flex rounded-md bg-white px-6 py-3 font-semibold text-red-900 transition hover:bg-white/90"
        >
          Order Online
        </a>

      </div>

    </section>

  </main>


  <!-- FOOTER -->

  <Footer />

</Layout>