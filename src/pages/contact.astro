---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { restaurant } from "../data/restaurant";

const title =
  "Contact & Hours | Tokyo Sushi & Korean Bistro";

const description =
  "Contact Tokyo Sushi & Korean Bistro in Fort Lauderdale, Florida. Find restaurant hours, directions and ordering information.";
---

<Layout
  title={title}
  description={description}
>

  <Header />

  <main>

    <section class="bg-[#181512] text-white">

      <div
        class="mx-auto max-w-7xl px-5 py-20 text-center lg:px-8"
      >

        <p
          class="text-sm font-semibold uppercase tracking-[0.22em] text-red-400"
        >
          Visit Us
        </p>

        <h1
          class="mt-4 text-5xl font-bold tracking-tight sm:text-6xl"
        >
          Contact & Hours
        </h1>

        <p
          class="mx-auto mt-5 max-w-xl text-lg leading-8 text-white/70"
        >
          We'd love to serve you.
        </p>

      </div>

    </section>


    <section class="py-20">

      <div
        class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2 lg:px-8"
      >

        <!-- CONTACT -->

        <div>

          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-red-800"
          >
            Restaurant
          </p>

          <h2
            class="mt-3 text-3xl font-bold"
          >
            {restaurant.name}
          </h2>


          <div
            class="mt-8 space-y-6 text-black/70"
          >

            <div>

              <p
                class="text-xs font-semibold uppercase tracking-wider text-black/40"
              >
                Location
              </p>

              <p class="mt-1">
                Fort Lauderdale, Florida
              </p>

            </div>


            {
              restaurant.phoneDisplay && (

                <div>

                  <p
                    class="text-xs font-semibold uppercase tracking-wider text-black/40"
                  >
                    Phone
                  </p>

                  <a
                    href={`tel:${restaurant.phone}`}
                    class="mt-1 inline-block font-medium text-black hover:text-red-800"
                  >
                    {restaurant.phoneDisplay}
                  </a>

                </div>

              )
            }


            {
              restaurant.email && (

                <div>

                  <p
                    class="text-xs font-semibold uppercase tracking-wider text-black/40"
                  >
                    Email
                  </p>

                  <a
                    href={`mailto:${restaurant.email}`}
                    class="mt-1 inline-block font-medium text-black hover:text-red-800"
                  >
                    {restaurant.email}
                  </a>

                </div>

              )
            }

          </div>


          <div class="mt-9 flex flex-wrap gap-3">

            {
              restaurant.links.googleMaps && (

                <a
                  href={restaurant.links.googleMaps}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-md bg-black px-5 py-3 font-semibold text-white"
                >
                  Get Directions
                </a>

              )
            }

            {
              restaurant.links.yelp && (

                <a
                  href={restaurant.links.yelp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-md border border-black/20 px-5 py-3 font-semibold"
                >
                  Yelp
                </a>

              )
            }

          </div>

        </div>


        <!-- HOURS -->

        <div
          class="rounded-xl border border-black/10 bg-white p-8"
        >

          <h2 class="text-2xl font-bold">
            Hours
          </h2>

          <div class="mt-6 divide-y divide-black/10">

            {
              restaurant.hours.map((entry) => (

                <div
                  class="flex justify-between gap-5 py-4 first:pt-0"
                >

                  <span class="font-medium">
                    {entry.days}
                  </span>

                  <span class="text-right text-black/60">
                    {entry.hours}
                  </span>

                </div>

              ))
            }

          </div>


          <a
            href={restaurant.links.order}
            class="mt-8 block rounded-md bg-red-800 px-6 py-3 text-center font-semibold text-white transition hover:bg-red-900"
          >
            Order Online
          </a>

        </div>

      </div>

    </section>

  </main>

  <Footer />

</Layout>