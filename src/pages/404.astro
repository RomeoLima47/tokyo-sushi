---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Page Not Found | Tokyo Sushi & Korean Bistro"
  description="The page you requested could not be found."
>

  <Header />

  <main
    class="flex min-h-[65vh] items-center justify-center px-5"
  >

    <div class="text-center">

      <p
        class="text-sm font-semibold uppercase tracking-[0.2em] text-red-800"
      >
        Error 404
      </p>

      <h1
        class="mt-4 text-5xl font-bold tracking-tight"
      >
        Page not found.
      </h1>

      <p
        class="mx-auto mt-5 max-w-md leading-7 text-black/60"
      >
        The page you're looking for may have moved or no longer exists.
      </p>

      <div
        class="mt-8 flex justify-center gap-3"
      >

        <a
          href="/"
          class="rounded-md bg-black px-6 py-3 font-semibold text-white"
        >
          Return Home
        </a>

        <a
          href="/menu"
          class="rounded-md border border-black/20 px-6 py-3 font-semibold"
        >
          View Menu
        </a>

      </div>

    </div>

  </main>

  <Footer />

</Layout>