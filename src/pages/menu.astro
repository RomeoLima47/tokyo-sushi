---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MenuSections from "../components/MenuSections.astro";
import { menu } from "../data/menu";
import { restaurant } from "../data/restaurant";

const title = "Dinner Menu | Tokyo Sushi & Korean Bistro – Fort Lauderdale";
const description =
  "Explore sushi, sashimi, Korean BBQ, ramen, house special rolls and more at Tokyo Sushi & Korean Bistro in Fort Lauderdale.";
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <section class="bg-[#181512] text-white">
      <div class="mx-auto max-w-7xl px-5 py-20 text-center lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-red-400">
          Tokyo Sushi & Korean Bistro
        </p>

        <h1 class="mt-4 text-5xl font-bold tracking-tight sm:text-6xl">
          Dinner Menu
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">
          Sushi, sashimi, Korean BBQ, ramen and house specialties.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/lunch"
            class="rounded-md border border-white/30 px-5 py-3 font-semibold transition hover:bg-white hover:text-black"
          >
            View Lunch Menu
          </a>

          <a
            href={restaurant.links.order}
            class="rounded-md bg-red-700 px-5 py-3 font-semibold text-white transition hover:bg-red-600"
          >
            Order Online
          </a>
        </div>
      </div>
    </section>

    <MenuSections sections={menu} />

    <section class="bg-red-900 text-white">
      <div class="mx-auto max-w-5xl px-5 py-16 text-center lg:px-8">
        <h2 class="text-3xl font-bold">Ready to order?</h2>
        <p class="mt-3 text-white/70">
          Order online for convenient pickup or delivery.
        </p>
        <a
          href={restaurant.links.order}
          class="mt-7 inline-flex rounded-md bg-white px-6 py-3 font-semibold text-red-900 transition hover:bg-white/90"
        >
          Order Online
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
