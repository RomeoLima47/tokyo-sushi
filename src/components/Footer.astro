---
import { restaurant } from "../data/restaurant";

const year = new Date().getFullYear();
---

<footer class="bg-[#181512] text-white">
  <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8">

    <div class="grid gap-10 md:grid-cols-3">

      <div>
        <h2 class="text-xl font-semibold">
          {restaurant.name}
        </h2>

        <p class="mt-3 max-w-sm text-sm leading-6 text-white/70">
          Japanese and Korean cuisine in Fort Lauderdale, Florida.
        </p>
      </div>

      <div>
        <h2 class="font-semibold">
          Explore
        </h2>

        <div class="mt-4 flex flex-col gap-2 text-sm text-white/70">
          <a href="/menu" class="hover:text-white">
            Menu
          </a>

          <a href="/#location" class="hover:text-white">
            Location
          </a>

          <a href="/contact" class="hover:text-white">
            Contact
          </a>

          <a
            href={restaurant.links.order}
            class="hover:text-white"
          >
            Order Online
          </a>
        </div>
      </div>

      <div>
        <h2 class="font-semibold">
          Visit
        </h2>

        <p class="mt-4 text-sm leading-6 text-white/70">
          Fort Lauderdale, Florida
        </p>
      </div>

    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-xs text-white/50">
      © {year} {restaurant.name}. All rights reserved.
    </div>

  </div>
</footer>